{
  "name": "@llakshit/bharat-mcp",
  "version": "0.1.0",
  "description": "Give your AI agent accurate Indian GST, PAN, Aadhaar-format, pincode, holiday and compliance knowledge. An MCP server that works offline.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "india",
    "gstin",
    "pan",
    "aadhaar",
    "pincode",
    "gst",
    "compliance",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "author": "Lakshit Mathur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lllakshit/bharat-mcp.git"
  },
  "homepage": "https://github.com/lllakshit/bharat-mcp#readme",
  "bugs": {
    "url": "https://github.com/lllakshit/bharat-mcp/issues"
  },
  "type": "module",
  "bin": {
    "bharat-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "DATA-SOURCES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:pincodes": "node scripts/build-pincodes.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "node scripts/demo.mjs",
    "bench": "node bench/perf.mjs",
    "bench:llm": "node bench/llm/run.mjs",
    "bench:ollama": "node bench/llm/ollama.mjs",
    "smoke": "node scripts/smoke.mjs",
    "proof": "node scripts/make-proof.mjs",
    "video": "node scripts/record-demo.mjs 1400 && swiftc -O scripts/video/render-demo-video.swift -o /tmp/bharat-render-video && /tmp/bharat-render-video docs/proof/demo-timing.json bharat-mcp-demo.mp4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
